# Copy to .env and fill in. Never commit the real .env.

# --- Host paths (bind mounts) -----------------------------------------
VIDEO_ROOT=/mnt/data/samba_share/Video/Lewis_family_videos
OUTPUT_ROOT=/mnt/data/samba_share/Video/Lewis_family_VHS_video_clips
APPDATA_ROOT=/mnt/fast_storage/appdata/sceneclip

# uid:gid the web/worker/worker_encode containers run as (see `user:` in
# docker-compose.yml) -- without this they default to root, and every file
# they write to the bind mounts above (encoded clips, thumbnails, preview
# clips) comes out root-owned on the host. Set to `id -u`:`id -g` for
# whichever host user should own them; run `id <username>` if setting this
# up for someone else.
APP_UID=1000
APP_GID=1000

# --- Django --------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=sceneclip.exploretheworld.tech,localhost
APP_DOMAIN=sceneclip.exploretheworld.tech
CORS_ALLOWED_ORIGINS=

# --- Postgres --------------------------------------------------------------
POSTGRES_DB=sceneclip
POSTGRES_USER=sceneclip
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Celery/Redis ----------------------------------------------------------
# Must use the container_name (sceneclip_redis), not the bare compose
# service name ("redis") -- this host runs several unrelated projects
# sharing the external traefik_proxy network, each with their own
# container named "redis", and Compose registers the service name as a
# network alias too. The bare name is genuinely ambiguous: DNS round-robins
# across every "redis" container on the network, so about a third of calls
# silently went to someone else's Redis. Same reasoning applies to "web" in
# frontend/nginx.conf -- always use the unique container_name for anything
# proxied/connected to over this shared network.
CELERY_BROKER_URL=redis://sceneclip_redis:6379/0

# --- Authelia OIDC client secret (plaintext here; Authelia's own config
# stores the hashed version -- see the client block to add to
# authelia/config/configuration.yml, generated with:
#   docker exec -it authelia authelia crypto hash generate pbkdf2 \
#     --variant sha512 --password "paste-this-same-value-here"
AUTHELIA_SECRET=change-me
